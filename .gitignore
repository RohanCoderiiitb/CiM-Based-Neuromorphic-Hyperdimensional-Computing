# datasets and environments (large, local)
/data/
/myenv/
/venv/
.venv/

# local planning document
IMPLEMENTATION_README.md

# Python / tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# OS / editor metadata
.DS_Store
.vscode/
.idea/

# crossbar simulations: regenerable build products and large intermediate tables
# compiled rram.osdi + cached toolchain paths (spice/osdi.py rebuilds them)
studies/crossbar/spice/build/
# 1D-ii pulse flow maps, ~20 MB (python -m program.tables --which all)
studies/crossbar/results/program_verify/tables/
*.osdi

# RTL flow (also in design/rtl/.gitignore)
design/rtl/tools/
design/rtl/build/
design/rtl/sim_build/
design/rtl/results/scratch/

# the Cadence 45 nm PDK (licensed material, includes a secured lab PDF and a licence-server cshrc): never commit; the flows read it from here
/45_nm_PDK/
# generated per-build inputs of the owner's Genus / Innovus runs (rebuilt by design/rtl/synth/prepare_rtl.py)
/design/rtl/synth/work/

# regenerable P&R databases / netlists / guides of the OpenROAD run (design/rtl/synth/openroad/run_flow.sh rebuilds them) and per-run scratch
/design/rtl/synth/results/openroad/*/*.odb
/design/rtl/synth/results/openroad/*/*.def
/design/rtl/synth/results/openroad/*/*.v
/design/rtl/synth/results/openroad/*/route.guide
/design/rtl/synth/results/layout/*/*/power_*/
/design/rtl/synth/results/ports/
# Generated simulation binaries and waveforms
*.vvp
*.vcd

/datasets
# CIFAR10-DVS (dropped from the report; the runs are kept locally only)
/design/reference_model/tb/vectors/cifar10dvs/
/design/reference_model/tb/vectors/cifar10dvs_large/
/design/reference_model/tb/vectors/weights/*c10r1s*
/design/reference_model/tb/vectors/weights/*c10Lunfs*
/design/rtl/results/hdc/*c10*
/studies/algorithm/phase4_more_datasets/artifacts/cifar10dvs/
/studies/algorithm/phase4_more_datasets/artifacts/cifar10dvs_large/

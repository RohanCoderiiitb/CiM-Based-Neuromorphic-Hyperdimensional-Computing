/studies/algorithm/phase4_more_datasets/src/export_cifar10dvs.py
/studies/algorithm/phase4_more_datasets/src/export_cifar10dvs_large.py

# ASL-DVS golden traces, 50-65 MB each (studies/algorithm/phase4_more_datasets/src/export_asldvs.py --model unf rebuilds them)
/design/reference_model/tb/vectors/asldvs/*_seed*.npz

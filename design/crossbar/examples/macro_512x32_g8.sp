* 2T2R ReRAM crossbar: 512 rows x 32 cells (1 macro(s)), g = 8, device = resistor, tx = switch, weights seed 0, rows 24..31 selected
* generated by design/crossbar/crossbar_netlist (do not edit; regenerate)
.options reltol=1e-10 abstol=1e-16 vntol=1e-13 itl1=1000 gmin=1e-18 noopac
* --- device: a FIXED resistor at the read bias, R = V_read / I(V_read) of the Stanford-PKU law (constants.py): R_LRS at gap 0.2 nm, R_HRS at gap 1.7 nm
.param i0=0.001 g0=0.25 v0=0.25 gmin_dev=9.9999999999999998e-13
.param gap_lrs=0.20000000000000001 gap_hrs=1.7 r_lrs=541.82065139541294 r_hrs=218586.00402048207
* --- access transistor (linear-equivalent R_tx at the read bias, 1A; a switch gated by the word line) and row driver (a behavioural switch, R_DRV when on)
.param r_tx=1016.0459 r_drv=10 v_wl=1.1000000000000001 v_read=0.10000000000000001
.model swtx sw(vt=0.55000000000000004 vh=0 ron=1016.0459 roff=10000000000000000)
* --- wires: ohm per cell pitch
.param r_bl=0.71999999999999997 r_wl=0.71999999999999997
* --- parasitic capacitance per pitch: ground share and neighbour-coupling share of c_line (1C convention: cc_fraction/2 to each neighbour)
.param c_line=2e-16 cg_node=9.9999999999999998e-17 cc_node=4.9999999999999999e-17 c_sense=5e-15

* ---------------------------------------------------------------- half: one device + one access transistor (a = gap [nm] or R [ohm])
.subckt half rl wl bl params: a=1
Rd rl x {a}
St x bl wl 0 swtx
.ends half

* ---------------------------------------------------------------- cell2t2r: the differential cell
.subckt cell2t2r rlp rlm wl blp blm params: ap=1 am=1
Xp rlp wl blp half a={ap}
Xm rlm wl blm half a={am}
.ends cell2t2r

* ---------------------------------------------------------------- row driver: row line to the supply tap when the word line is high, pulled to 0 V when it is low
.subckt rowdrv sup out en
* behavioural switch: conductance 1/r_drv times a smooth gate g(V(en)) = (1+tanh((V(en)-v_wl/2)/0.01))/2, exactly 1 / 1e-48 at the two word-line levels
Bu sup out I = V(sup,out)/{r_drv}*0.5*(1+tanh((V(en)-{v_wl/2})/0.01))
Bd out 0 I = V(out)/{r_drv}*0.5*(1-tanh((V(en)-{v_wl/2})/0.01))
.ends rowdrv

* ---------------------------------------------------------------- group: g contiguous cells on one bitline pair (+ a single-bitline variant for odd block widths)
.subckt grp2_8 rp0 rm0 wl0 rp1 rm1 wl1 rp2 rm2 wl2 rp3 rm3 wl3 rp4 rm4 wl4 rp5 rm5 wl5 rp6 rm6 wl6 rp7 rm7 wl7 nbp nbm tp0 tp1 tp2 tp3 tp4 tp5 tp6 tp7
